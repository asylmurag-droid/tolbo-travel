rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'XQV7T25exbddbDFvG9iRRHawNjI2';
    }
    match /visitors/{visitorId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName','email','phone','country','interest','message','company','facebook',
          'createdAt','priority','contactStatus','adminNote','viewStatus','viewedAt'
        ]) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 160 &&
        request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254 &&
        request.resource.data.phone is string && request.resource.data.phone.size() <= 60 &&
        request.resource.data.country is string && request.resource.data.country.size() <= 100 &&
        request.resource.data.interest is string && request.resource.data.interest.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 3000 &&
        request.resource.data.company == '' && request.resource.data.facebook == '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.priority == 2 && request.resource.data.contactStatus == 'New' &&
        request.resource.data.adminNote == '' && request.resource.data.viewStatus == 'new' &&
        request.resource.data.viewedAt == null;
      allow read, update, delete: if isAdmin();
    }
  }
}